{
  "name": "EMO",
  "version": "1.0.0",
  "private": true,
  "description": "Minimalist Offline AI Desk Assistant & Agent Monitor",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "start": "react-native start",
    "lint": "eslint .",
    "test": "jest",
    "build:android": "cd android && ./gradlew assembleDebug",
    "deploy": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk && adb shell am start -n com.emo/.MainActivity"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-native": "0.74.5",
    "react-native-reanimated": "^3.12.0",
