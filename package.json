    "react-native-keep-awake": "^4.0.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/runtime": "^7.24.0",
    "@react-native/babel-preset": "^0.74.83",
    "@react-native/metro-config": "^0.74.83",
    "@types/react": "^18.3.3",
    "@types/react-native": "^0.72.8",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
